/**
 * ============================================================
 * SKOS - Smaily Knowledge Operating System
 * Security Schema
 * ------------------------------------------------------------
 * File      : security-schema.json
 * Operation : OP-012
 * Build     : BUILD-000353
 * Version   : 1.0.0
 * Status    : ACTIVE
 * ============================================================
 *
 * Mission:
 * Defines the standard security data model for SKOS.
 *
 * Purpose:
 * - Identity standardization
 * - Access control consistency
 * - Permission definition
 * - Encryption metadata
 * - Security audit structure
 *
 * Principle:
 * Security Schema defines the language of trust.
 * It does not execute security operations.
 * ============================================================
 */


{
  "schema": {

    "name": "SKOS Security Schema",

    "version": "1.0.0",

    "namespace": "skos.security"

  },


  "security": {


    "identity": {

      "id": "string",

      "type": [

        "HUMAN",

        "ENGINE",

        "AI_AGENT",

        "SYSTEM",

        "ORGANIZATION",

        "KNOWLEDGE_NODE"

      ],

      "status": [

        "ACTIVE",

        "INACTIVE",

        "SUSPENDED",

        "REVOKED"

      ],

      "metadata": "object",

      "createdAt": "datetime",

      "updatedAt": "datetime"

    },



    "authentication": {

      "id": "string",

      "identity": "string",

      "method": [

        "PASSWORD",

        "API_KEY",

        "TOKEN",

        "OAUTH",

        "CERTIFICATE",

        "CUSTOM"

      ],

      "status": [

        "VALID",

        "EXPIRED",

        "INVALID"

      ],

      "timestamp": "datetime"

    },



    "permission": {

      "id": "string",

      "name": "string",

      "category": "string",

      "level": [

        "LOW",

        "STANDARD",

        "HIGH",

        "CRITICAL"

      ],

      "status": [

        "ACTIVE",

        "INACTIVE"

      ]

    },



    "role": {

      "id": "string",

      "name": "string",

      "permissions": [

        "string"

      ],

      "createdAt": "datetime"

    },



    "accessDecision": {

      "id": "string",

      "identity": "string",

      "resource": "string",

      "operation": "string",

      "decision": [

        "GRANTED",

        "DENIED"

      ],

      "reason": "string",

      "timestamp": "datetime"

    },



    "encryption": {

      "id": "string",

      "algorithm": "string",

      "keyReference": "string",

      "dataType": "string",

      "operation": [

        "ENCRYPT",

        "DECRYPT",

        "HASH"

      ],

      "timestamp": "datetime"

    },



    "securityEvent": {

      "id": "string",

      "type": [

        "IDENTITY",

        "ACCESS",

        "AUTHENTICATION",

        "ENCRYPTION",

        "POLICY",

        "SECURITY_FAILURE"

      ],

      "severity": [

        "INFO",

        "WARNING",

        "ERROR",

        "CRITICAL"

      ],

      "source": "string",

      "payload": "object",

      "timestamp": "datetime"

    }



  },


  "validation": {


    "requiredIdentityFields": [

      "id",

      "type",

      "status"

    ],


    "requiredPermissionFields": [

      "id",

      "name",

      "status"

    ],


    "requiredAccessFields": [

      "identity",

      "resource",

      "operation",

      "decision"

    ],


    "requiredEventFields": [

      "id",

      "type",

      "timestamp"

    ]

  },


  "securityPolicy": {


    "auditRequired": true,

    "encryptionRequired": true,

    "identityVerificationRequired": true,

    "accessControlRequired": true,

    "eventLoggingRequired": true

  },


  "futureExtensions": {


    "zeroTrustArchitecture": true,

    "federatedIdentity": true,

    "hardwareSecurityModule": true,

    "biometricAuthentication": true,

    "behavioralSecurityAnalysis": true,

    "aiThreatDetection": true,

    "enterpriseCompliance": true

  }


}
