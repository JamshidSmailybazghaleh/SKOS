/**
 * ============================================================
 * SKOS - Smaily Knowledge Operating System
 * Integration Schema
 * ------------------------------------------------------------
 * File      : integration-schema.json
 * Operation : OP-011
 * Build     : BUILD-000345
 * Version   : 1.0.0
 * Status    : ACTIVE
 * ============================================================
 *
 * Mission:
 * Defines the standard data structure for SKOS integrations.
 *
 * Purpose:
 * - Integration standardization
 * - Connector communication format
 * - Adapter compatibility
 * - Synchronization definition
 * - Authentication metadata
 * - Audit consistency
 *
 * Principle:
 * Schema defines integration language.
 * It does not execute integration operations.
 * ============================================================
 */


{
  "schema": {

    "name": "SKOS Integration Schema",

    "version": "1.0.0",

    "namespace": "skos.integration"

  },


  "integration": {


    "connector": {

      "id": "string",

      "name": "string",

      "type": "string",

      "provider": "string",

      "version": "string",

      "status": [
        "REGISTERED",
        "ACTIVE",
        "INACTIVE",
        "FAILED"
      ],

      "metadata": "object"

    },



    "adapter": {

      "id": "string",

      "name": "string",

      "type": "string",

      "targetSystem": "string",

      "version": "string",

      "status": [
        "REGISTERED",
        "ACTIVE",
        "INACTIVE"
      ],

      "capabilities": [

        "READ",

        "WRITE",

        "SYNC",

        "EXPORT",

        "IMPORT"

      ]

    },



    "connection": {

      "id": "string",

      "source": "string",

      "target": "string",

      "createdAt": "datetime",

      "status": [

        "CONNECTING",

        "CONNECTED",

        "DISCONNECTED",

        "FAILED"

      ],

      "authentication": "object",

      "configuration": "object"

    },



    "synchronization": {

      "id": "string",

      "source": "string",

      "target": "string",

      "mode": [

        "MANUAL",

        "SCHEDULED",

        "REAL_TIME"

      ],

      "direction": [

        "IMPORT",

        "EXPORT",

        "BIDIRECTIONAL"

      ],

      "status": [

        "CREATED",

        "QUEUED",

        "RUNNING",

        "COMPLETED",

        "FAILED",

        "CANCELLED"

      ],

      "startedAt": "datetime",

      "completedAt": "datetime",

      "statistics": {

        "processed": "number",

        "successful": "number",

        "failed": "number"

      }

    },



    "authentication": {

      "provider": "string",

      "method": [

        "API_KEY",

        "TOKEN",

        "OAUTH",

        "CERTIFICATE",

        "CUSTOM"

      ],

      "status": [

        "VALID",

        "EXPIRED",

        "INVALID"

      ],

      "metadata": "object"

    },



    "integrationEvent": {

      "id": "string",

      "timestamp": "datetime",

      "source": "string",

      "eventType": "string",

      "payload": "object",

      "severity": [

        "INFO",

        "WARNING",

        "ERROR",

        "CRITICAL"

      ]

    }


  },


  "validation": {


    "requiredConnectorFields": [

      "id",

      "name",

      "type",

      "status"

    ],


    "requiredAdapterFields": [

      "id",

      "name",

      "targetSystem"

    ],


    "requiredConnectionFields": [

      "id",

      "source",

      "target",

      "status"

    ],


    "requiredSyncFields": [

      "id",

      "source",

      "target",

      "status"

    ]

  },


  "security": {


    "authenticationSupported": true,

    "authorizationSupported": false,

    "encryptionSupported": false,

    "auditRequired": true

  },


  "futureExtensions": {


    "distributedIntegration": true,

    "cloudNativeConnectors": true,

    "enterpriseAdapters": true,

    "realTimeSynchronization": true,

    "federatedKnowledgeIntegration": true,

    "crossPlatformDataExchange": true

  }


}
